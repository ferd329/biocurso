# BioCursos — Apache (XAMPP)
#
# La aplicación navega con rutas en el hash (#/planes, #/curso/..., #/admin),
# así que el servidor siempre entrega index.html y no hacen falta reglas de
# reescritura. Este archivo sólo añade compresión, caché y cabeceras básicas.
#
# Sólo es necesario si publicas el sitio con Apache.

AddDefaultCharset UTF-8
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# Compresión
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caché del navegador
# El HTML se sirve siempre fresco; los assets estáticos pueden cachearse.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ---------------------------------------------------------------------------
# Cabeceras de seguridad básicas
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
